{
	"type": "module",
	"name": "@omp-console/web",
	"version": "0.0.0",
	"private": true,
	"description": "omp-console web UI: PWA for iPhone, shell target for Mac and Android.",
	"license": "MIT",
	"scripts": {
		"dev": "bun dev/dev-server.ts",
		"mock-daemon": "bun dev/mock-daemon.ts",
		"bench": "bun bench/run-headless.ts",
		"screens": "bash test/screens/capture.sh",
		"screens:agents": "bash test/screens/capture-agents.sh",
		"prebuild": "bun scripts/check-bun.ts",
		"build": "rm -rf dist && bun build ./index.html --outdir=dist --minify --splitting --define process.env.NODE_ENV='\"production\"' --entry-naming=[hash].[ext] --chunk-naming=[hash].[ext] --asset-naming=[hash].[ext] && mv dist/*.html dist/index.html && cp -R public/. dist/",
		"postbuild": "bun scripts/build-pwa.ts",
		"test": "bun test --parallel",
		"check:types": "tsgo -p tsconfig.json --noEmit && tsgo -p pwa/tsconfig.json --noEmit"
	},
	"engines": {
		"bun": ">=1.4"
	},
	"dependencies": {
		"@omp-console/protocol": "workspace:*",
		"@oh-my-pi/pi-tui": "catalog:",
		"@oh-my-pi/pi-utils": "catalog:",
		"@oh-my-pi/pi-wire": "catalog:",
		"dockview-react": "8.6.1",
		"katex": "catalog:",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:"
	}
}
